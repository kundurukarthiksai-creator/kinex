# ASU OpenAI-compatible server (https://openai.rc.asu.edu). Save this file as .env
OPENAI_API_KEY=
# Optional overrides
# OPENAI_MODEL=qwen38-27b
# OPENAI_BASE_URL=https://openai.rc.asu.edu/v1

# Gemini also works through the compatible API:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.5-flash-lite

# Optional ASU image-to-3D service, configured separately from the chat provider.
# MESH_API_KEY=
# MESH_BASE_URL=https://openai.rc.asu.edu/v1
